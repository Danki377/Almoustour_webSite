# Copy this file to .env (never commit .env) and fill in the values.
# On Vercel: Project → Settings → Environment Variables.

# Neon → Dashboard → Connect → pooled connection string (host contains "-pooler").
# Migrations automatically use the direct host (same URL without "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Optional: explicit direct URL for migrations
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Better Auth. Secret: 32+ random characters, generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
# Public URL of the site (production: https://your-domain). On Vercel previews the deployment URL is used automatically.
BETTER_AUTH_URL="http://localhost:3000"

# First super admin, created by `pnpm db:seed`. Remove the password once the account exists.
SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD=""
SUPERADMIN_NAME="Super admin"
